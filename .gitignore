# ========================================
# Gleydsontattoo — Git Ignore
# ========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Uploads (user content)
backend/uploads/*
!backend/uploads/.gitkeep

# Database
*.sql.bak
*.dump

# Docker volumes
pgdata/
redis-data/

# Test coverage
coverage/
.nyc_output/

# Prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# Misc
*.tsbuildinfo
.turbo/

