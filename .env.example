# ========================================
# Gleydsontattoo — Environment Variables
# ========================================
# Copy this file to .env and fill in the values

# ── Application ──
NODE_ENV=development
APP_NAME=Gleydsontattoo
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Database ──
# Local PostgreSQL
# DATABASE_URL=postgresql://gleydsontattoo:gleydsontattoo_dev@localhost:5432/gleydsontattoo?schema=public

# Supabase PostgreSQL (comentado - preencher com sua URL real)
# DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres?schema=public

# ── JWT ──
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Admin Initial Credentials ──
ADMIN_EMAIL=admin@gleydsontattoo.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_2024!
ADMIN_NAME=Gleydson

# ── WhatsApp Integration ──
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=gleydsontattoo
WHATSAPP_DEFAULT_NUMBER=5591999999999

# ── Upload ──
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif

# ── CORS ──
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=

# ── Studio Info (overridden by DB settings) ──
STUDIO_PHONE=5591999999999
STUDIO_ADDRESS=R. Domingos Silva, 84 — Barcarena, PA — 68445-000
STUDIO_INSTAGRAM=@gleydsontattoo

