# ========================================
# Gleydsontattoo — Environment Variables
# ========================================
# Copy this file to .env and fill in the values with your actual configuration

# ── Application ──
NODE_ENV=development
APP_NAME=Gleydsontattoo
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WHATSAPP_NUMBER=5591999999999

# ── Database ──
# PostgreSQL Connection String (required)
# Local: postgresql://user:password@localhost:5432/dbname?schema=public
# Supabase: postgresql://postgres.[PROJECT_ID]:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/gleydsontattoo?schema=public

# ── JWT Authentication (required) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_character_random_string_here_change_this_in_production
JWT_REFRESH_SECRET=another_64_character_random_string_here_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Admin Initial Credentials (required) ──
ADMIN_EMAIL=admin@gleydsontattoo.com
ADMIN_PASSWORD=YourStrongPassword2024!Min8Chars
ADMIN_NAME=Gleydson

# ── WhatsApp Integration (optional) ──
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=gleydsontattoo
WHATSAPP_DEFAULT_NUMBER=5591999999999

# ── File Upload (optional) ──
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif
UPLOAD_STORAGE_PATH=./uploads

# ── CORS (optional) ──
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting (optional) ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Third-Party APIs (optional) ──
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
ANALYTICS_ID=

# ── Studio Information (optional - overridden by DB settings) ──
STUDIO_PHONE=5591999999999
STUDIO_ADDRESS=R. Domingos Silva, 84 — Barcarena, PA — 68445-000
STUDIO_INSTAGRAM=@gleydsontattoo
STUDIO_EMAIL=contato@gleydsontattoo.com

