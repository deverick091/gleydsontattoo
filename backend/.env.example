# ========================================
# Gleydsontattoo Backend — Environment Template
# ========================================

# ── Application ──
NODE_ENV=development
PORT=3001

# ── Database (Supabase) ──
# Obtém em: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres?schema=public

# ── Supabase ──
# Obtém em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_KEY...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...  # Use apenas em ambiente seguro

# ── JWT ──
JWT_SECRET=your_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# ── Admin Initial Credentials ──
ADMIN_EMAIL=Admin@admin.com
ADMIN_PASSWORD=Admin@12345678

# ── CORS ──
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Upload ──
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif
