# ========================================
# Gleydsontattoo Backend — Environment Variables
# ========================================
# Copy this file to .env and fill in the values

# ── Application ──
NODE_ENV=development
PORT=3001

# ── Database ──
DATABASE_URL=postgresql://gleydsontattoo:gleydsontattoo_dev@localhost:5432/gleydsontattoo?schema=public

# ── JWT ──
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# ── Admin Initial Credentials ──
ADMIN_EMAIL=admin@gleydsontattoo.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_2024!

# ── CORS ──
CORS_ORIGIN=http://localhost:3000

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Upload ──
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif
