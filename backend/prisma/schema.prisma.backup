generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ATTENDANT
}

enum PriceType {
  FIXED
  STARTING_AT
  CONSULTATION
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BlockReason {
  VACATION
  HOLIDAY
  MAINTENANCE
  PERSONAL
  OTHER
}

enum BudgetStatus {
  PENDING
  RESPONDED
  CONVERTED
  REJECTED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  POST_SERVICE
}

enum Channel {
  WHATSAPP
  EMAIL
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs    AuditLog[]
  professional Professional?

  @@map("users")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String
  whatsapp  String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  budgets        Budget[]
  consentRecords ConsentRecord[]

  @@map("clients")
}

model Professional {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  bio         String?
  avatar      String?
  specialties String[]
  isActive    Boolean  @default(true)
  userId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]
  timeSlots    TimeSlot[]
  blockedTimes BlockedTime[]

  @@map("professionals")
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  services       Service[]
  portfolioItems PortfolioItem[]

  @@map("service_categories")
}

model Service {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  duration    Int
  priceMin    Decimal?
  priceMax    Decimal?
  priceType   PriceType
  image       String?
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  categoryId  String

  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id              String            @id @default(uuid())
  clientId        String
  professionalId  String
  serviceId       String
  date            DateTime          @db.Date
  startTime       String
  endTime         String
  status          AppointmentStatus @default(PENDING)
  notes           String?
  bodyRegion      String?
  approximateSize String?
  stylePreference String?
  referenceImages String[]
  cancelReason    String?
  cancelledAt     DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  client       Client         @relation(fields: [clientId], references: [id])
  professional Professional   @relation(fields: [professionalId], references: [id])
  service      Service        @relation(fields: [serviceId], references: [id])
  notifications Notification[]

  @@unique([professionalId, date, startTime])
  @@map("appointments")
}

model TimeSlot {
  id             String  @id @default(uuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean @default(true)

  professional Professional @relation(fields: [professionalId], references: [id])

  @@unique([professionalId, dayOfWeek, startTime])
  @@map("time_slots")
}

model BlockedTime {
  id             String      @id @default(uuid())
  professionalId String
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  startTime      String?
  endTime        String?
  allDay         Boolean     @default(true)
  reason         BlockReason
  description    String?
  createdAt      DateTime    @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])

  @@map("blocked_times")
}

model PortfolioItem {
  id           String   @id @default(uuid())
  title        String
  description  String?
  imageUrl     String
  thumbnailUrl String?
  categoryId   String
  isFeatured   Boolean  @default(false)
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id])

  @@map("portfolio_items")
}

model Budget {
  id                     String       @id @default(uuid())
  clientId               String?
  name                   String
  whatsapp               String
  email                  String?
  style                  String?
  size                   String?
  bodyRegion             String?
  description            String?
  referenceImages        String[]
  approximateBudget      String?
  availability           String?
  status                 BudgetStatus @default(PENDING)
  adminResponse          String?
  convertedAppointmentId String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  client Client? @relation(fields: [clientId], references: [id])

  @@map("budgets")
}

model Notification {
  id            String             @id @default(uuid())
  appointmentId String?
  clientId      String?
  type          NotificationType
  channel       Channel
  message       String
  sentAt        DateTime?
  status        NotificationStatus @default(PENDING)
  error         String?
  createdAt     DateTime           @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Setting {
  id          String      @id @default(uuid())
  key         String      @unique
  value       String
  type        SettingType
  description String?
  updatedAt   DateTime    @updatedAt

  @@map("settings")
}

model SocialMediaPost {
  id        String   @id @default(uuid())
  imageUrl  String
  link      String?
  caption   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("social_media_posts")
}

model AnamnesisForm {
  id               String    @id @default(uuid())
  appointmentId    String?
  clientId         String?
  allergies        String?
  medications      String?
  healthConditions String?
  previousTattoos  Boolean
  skinSensitivity  String?
  consentGiven     Boolean
  signedAt         DateTime?
  createdAt        DateTime  @default(now())

  @@map("anamnesis_forms")
}

model ConsentRecord {
  id           String    @id @default(uuid())
  clientId     String
  type         String
  consentGiven Boolean
  ipAddress    String?
  givenAt      DateTime  @default(now())
  revokedAt    DateTime?

  client Client @relation(fields: [clientId], references: [id])

  @@map("consent_records")
}
