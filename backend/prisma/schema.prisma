generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BudgetStatus {
  PENDING
  RESPONDED
  CONVERTED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  duration    Int
  price       Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  appointments Appointment[]

  @@map("services")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String
  notes     String?
  createdAt DateTime @default(now())

  appointments Appointment[]
  budgets      Budget[]

  @@map("clients")
}

model Appointment {
  id          String            @id @default(uuid())
  clientName  String
  clientPhone String
  date        DateTime          @db.Date
  time        String
  status      AppointmentStatus @default(PENDING)
  
  clientId    String?
  serviceId   String

  client      Client?           @relation(fields: [clientId], references: [id])
  service     Service           @relation(fields: [serviceId], references: [id])
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("appointments")
}

model Portfolio {
  id          String   @id @default(uuid())
  title       String
  category    String?
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())

  @@map("portfolios")
}

model Budget {
  id          String       @id @default(uuid())
  clientName  String
  description String?
  status      BudgetStatus @default(PENDING)
  
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("budgets")
}
