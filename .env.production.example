# ========================================
# Gleydsontattoo — Production Environment
# ========================================
# Use this as reference for production deployments
# NEVER commit this file - use environment variables in platform settings

# ── Application ──
NODE_ENV=production
APP_NAME=Gleydsontattoo
APP_URL=https://seu-dominio.com.br
API_URL=https://seu-backend.herokuapp.com
PORT=3001
NEXT_PUBLIC_API_URL=https://seu-backend.herokuapp.com

# ── Database (Supabase) ──
DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres?schema=public

# ── JWT (GERAR VALORES ALEATÓRIOS FORTES) ──
# Use: openssl rand -base64 32
JWT_SECRET=SUA_CHAVE_SECRETA_64_CARACTERES_AQUI
JWT_REFRESH_SECRET=SUA_CHAVE_REFRESH_64_CARACTERES_AQUI
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Admin Inicial ──
ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_PASSWORD=SENHA_FORTE_AQUI_MINIMO_12_CARACTERES
ADMIN_NAME=Gleydson

# ── WhatsApp Integration ──
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=https://seu-evolution-api.com
WHATSAPP_API_KEY=sua_chave_api_aqui
WHATSAPP_INSTANCE=gleydsontattoo
WHATSAPP_DEFAULT_NUMBER=5591999999999

# ── Upload ──
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif

# ── CORS (seu domínio frontend exato) ──
CORS_ORIGIN=https://seu-dominio.com.br

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=sua_chave_aqui

# ── Studio Info (será sobrescrito por DB) ──
STUDIO_PHONE=5591999999999
STUDIO_ADDRESS=R. Domingos Silva, 84 — Barcarena, PA — 68445-000
STUDIO_INSTAGRAM=@gleydsontattoo

# ── Logging (opcional) ──
LOG_LEVEL=info

# ── Sentry (error tracking - opcional) ──
# SENTRY_DSN=sua_dsn_aqui
